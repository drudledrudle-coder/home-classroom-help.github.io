# Cache rules, in the form both Cloudflare and Netlify read.
#
# The first two are not optional. The service worker decides every other file's
# lifetime, and index.html names the hashed assets — so a cached copy of either
# pins the whole app to an old build with no way to ship a fix, ever.

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Hashed filenames, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
